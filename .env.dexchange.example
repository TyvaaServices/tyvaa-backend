# DEXCHANGE Payment Configuration
# Add these environment variables to your .env file

# DEXCHANGE API Configuration
DEXCHANGE_BASE_URL=https://api-m.dexchange.sn/api/v1
DEXCHANGE_API_KEY=your_dexchange_api_key_here
DEXCHANGE_WEBHOOK_SECRET=your_webhook_secret_here

# Payment Configuration
DEFAULT_PAYMENT_PROVIDER=dexchange
DEFAULT_COUNTRY=SN
DEFAULT_CURRENCY=XOF

# Webhook URLs (replace with your actual domain)
PAYMENT_WEBHOOK_BASE_URL=https://your-domain.com/api/v1/payments
PAYMENT_RETURN_BASE_URL=https://your-domain.com/payment

# Example webhook URLs:
# DEXCHANGE webhook: https://your-domain.com/api/v1/payments/dexchange/webhook
# Payment return: https://your-domain.com/payment/result
